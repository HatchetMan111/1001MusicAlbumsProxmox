[Unit]
Description=AlbumsDashboard - lokale Checkliste zu 1001 Albums You Must Hear Before You Die
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=albumsdashboard
Group=albumsdashboard
WorkingDirectory=/opt/albumsdashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/albumsdashboard/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

# Haertung, ohne die App-Funktion einzuschraenken
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/albumsdashboard/data

[Install]
WantedBy=multi-user.target
